aquatox_data_root = 'data/aquatox'
aquatox_model_csv = 'data/aquatox/data/common_intersection_model.csv'
aquatox_cv_roles = 'data/aquatox/manifests/cv_roles.csv.gz'
cv_protocol = 'scaffold'
outer_fold_id = 0
dataset_layer = 'common_intersection'
YieldDataset.preprocessed_dir = 'preprocessed_graphs_local/aquatox'
YieldDataset.file_path = %aquatox_model_csv
YieldDataset.manifest_path = %aquatox_cv_roles
YieldDataset.cv_protocol = %cv_protocol
YieldDataset.outer_fold_id = %outer_fold_id
YieldDataset.dataset_layer = %dataset_layer
YieldDataset.contrastive = False
build_train_dataset_fish_ec50/YieldDataset.task = 'fish_EC50'
build_train_dataset_fish_ec50/YieldDataset.split_role = 'outer_train'
build_valid_dataset_fish_ec50/YieldDataset.task = 'fish_EC50'
build_valid_dataset_fish_ec50/YieldDataset.split_role = 'inner_val'
build_test_dataset_fish_ec50/YieldDataset.task = 'fish_EC50'
build_test_dataset_fish_ec50/YieldDataset.split_role = 'outer_test'
build_train_dataset_fish_ec10/YieldDataset.task = 'fish_EC10'
build_train_dataset_fish_ec10/YieldDataset.split_role = 'outer_train'
