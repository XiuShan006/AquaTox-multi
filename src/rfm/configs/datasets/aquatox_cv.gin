build_valid_dataset_aquatic_invertebrates_ec50/YieldDataset.split_role = 'inner_val'
build_test_dataset_aquatic_invertebrates_ec50/YieldDataset.task = 'aquatic_invertebrates_EC50'
build_test_dataset_aquatic_invertebrates_ec50/YieldDataset.split_role = 'outer_test'
build_train_dataset_aquatic_invertebrates_ec10/YieldDataset.task = 'aquatic_invertebrates_EC10'
build_train_dataset_aquatic_invertebrates_ec10/YieldDataset.split_role = 'outer_train'
build_valid_dataset_aquatic_invertebrates_ec10/YieldDataset.task = 'aquatic_invertebrates_EC10'
build_valid_dataset_aquatic_invertebrates_ec10/YieldDataset.split_role = 'inner_val'
build_test_dataset_aquatic_invertebrates_ec10/YieldDataset.task = 'aquatic_invertebrates_EC10'
build_test_dataset_aquatic_invertebrates_ec10/YieldDataset.split_role = 'outer_test'
build_train_dataset_algae_ec50/YieldDataset.task = 'algae_EC50'
build_train_dataset_algae_ec50/YieldDataset.split_role = 'outer_train'
build_valid_dataset_algae_ec50/YieldDataset.task = 'algae_EC50'
build_valid_dataset_algae_ec50/YieldDataset.split_role = 'inner_val'
build_test_dataset_algae_ec50/YieldDataset.task = 'algae_EC50'
build_test_dataset_algae_ec50/YieldDataset.split_role = 'outer_test'
build_train_dataset_algae_ec10/YieldDataset.task = 'algae_EC10'
build_train_dataset_algae_ec10/YieldDataset.split_role = 'outer_train'
build_valid_dataset_algae_ec10/YieldDataset.task = 'algae_EC10'
build_valid_dataset_algae_ec10/YieldDataset.split_role = 'inner_val'
build_test_dataset_algae_ec10/YieldDataset.task = 'algae_EC10'
build_test_dataset_algae_ec10/YieldDataset.split_role = 'outer_test'
train_datasets = {
    'fish_EC50': @build_train_dataset_fish_ec50/YieldDataset(),
    'fish_EC10': @build_train_dataset_fish_ec10/YieldDataset(),
    'aquatic_invertebrates_EC50': @build_train_dataset_aquatic_invertebrates_ec50/YieldDataset(),
