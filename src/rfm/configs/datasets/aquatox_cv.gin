build_valid_dataset_fish_ec10/YieldDataset.split_role = 'inner_val'
build_test_dataset_fish_ec10/YieldDataset.task = 'fish_EC10'
build_test_dataset_fish_ec10/YieldDataset.split_role = 'outer_test'
build_train_dataset_aquatic_invertebrates_ec50/YieldDataset.task = 'aquatic_invertebrates_EC50'
build_train_dataset_aquatic_invertebrates_ec50/YieldDataset.split_role = 'outer_train'
