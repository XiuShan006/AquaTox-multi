include './src/rfm/configs/rfm_train.gin'
OptimizerBase.cls_name = 'Adam'
OptimizerBase.lr = 2e-4
OptimizerBase.weight_decay = 1e-5
YieldTrainer.checkpoint_best = True
YieldTrainer.test_datasets = {}
YieldTrainer.best_metric = 'avg_rmse'
YieldTrainer.metric_direction = 'min'
YieldTrainer.scheduler_mode = 'step'
YieldTrainer.warmup_epochs = 5
YieldTrainer.warmup_fraction = 0.05
YieldTrainer.min_lr = 1e-6
YieldTrainer.lambda_mu = 0.5
YieldTrainer.huber_beta = 1.0
YieldTrainer.lambda_cls = 0.1
YieldTrainer.lambda_ord = 0.05
YieldTrainer.ordering_start_fraction = 0.0
YieldTrainer.gradient_diagnostics_every_n_epochs = 2
YieldTrainer.use_pcgrad = False
YieldTrainer.use_swa = False
YieldTrainer.n_epochs = 100
YieldTrainer.valid_every_n_epochs = 2
YieldTrainer.patience = 12
LocalFileLogger.logdir = @logdir/get_str()
logger/gin.singleton.constructor = @LocalFileLogger
YieldGNN.sigma_parameterization = 'clamp'
YieldGNN.min_log_sigma = -0.5
YieldGNN.max_log_sigma = 2.0
YieldGNN.fusion_mode = 'direct'
YieldGNN.modality_dropout = 0.0
YieldGNN.jk_mode = 'last'
YieldGNN.pooling_mode = 'gated'
YieldGNN.message_dropout = 0.0
YieldGNN.train_eps = False
YieldGNN.regression_mode = 'heteroscedastic'
