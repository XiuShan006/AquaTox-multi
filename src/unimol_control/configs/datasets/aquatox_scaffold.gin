aquatox_data_file = 'data/aquatox/data/common_intersection_model.csv'
aquatox_roles_file = 'data/aquatox/manifests/cv_roles.csv.gz'
aquatox_conformer_root = 'data/aquatox/conformers'
aquatox_conformer_audit = 'data/aquatox/audit/conformer_audit.csv'
YieldDataset.preprocessed_dir = 'preprocessed_graphs_local/aquatox'
YieldDataset.file_path = %aquatox_data_file
YieldDataset.roles_path = %aquatox_roles_file
YieldDataset.conformer_root = %aquatox_conformer_root
YieldDataset.conformer_audit_path = %aquatox_conformer_audit
YieldDataset.split_type = 'manifest'
YieldDataset.split_protocol = 'scaffold'
YieldDataset.outer_fold_id = 0
YieldDataset.unimol_precompute = False
build_train_dataset_fish_ec50/YieldDataset.task = 'fish_EC50'
build_train_dataset_fish_ec50/YieldDataset.split = 'train'
build_valid_dataset_fish_ec50/YieldDataset.task = 'fish_EC50'
build_valid_dataset_fish_ec50/YieldDataset.split = 'valid'
build_train_dataset_fish_ec10/YieldDataset.task = 'fish_EC10'
build_train_dataset_fish_ec10/YieldDataset.split = 'train'
build_valid_dataset_fish_ec10/YieldDataset.task = 'fish_EC10'
build_valid_dataset_fish_ec10/YieldDataset.split = 'valid'
build_train_dataset_invertebrates_ec50/YieldDataset.task = 'aquatic_invertebrates_EC50'
build_train_dataset_invertebrates_ec50/YieldDataset.split = 'train'
build_valid_dataset_invertebrates_ec50/YieldDataset.task = 'aquatic_invertebrates_EC50'
build_valid_dataset_invertebrates_ec50/YieldDataset.split = 'valid'
build_train_dataset_invertebrates_ec10/YieldDataset.task = 'aquatic_invertebrates_EC10'
build_train_dataset_invertebrates_ec10/YieldDataset.split = 'train'
build_valid_dataset_invertebrates_ec10/YieldDataset.task = 'aquatic_invertebrates_EC10'
build_valid_dataset_invertebrates_ec10/YieldDataset.split = 'valid'
build_train_dataset_algae_ec50/YieldDataset.task = 'algae_EC50'
build_train_dataset_algae_ec50/YieldDataset.split = 'train'
build_valid_dataset_algae_ec50/YieldDataset.task = 'algae_EC50'
build_valid_dataset_algae_ec50/YieldDataset.split = 'valid'
build_train_dataset_algae_ec10/YieldDataset.task = 'algae_EC10'
build_train_dataset_algae_ec10/YieldDataset.split = 'train'
build_valid_dataset_algae_ec10/YieldDataset.task = 'algae_EC10'
build_valid_dataset_algae_ec10/YieldDataset.split = 'valid'
train_datasets = {
    'fish_EC50': @build_train_dataset_fish_ec50/YieldDataset(),
    'fish_EC10': @build_train_dataset_fish_ec10/YieldDataset(),
    'aquatic_invertebrates_EC50': @build_train_dataset_invertebrates_ec50/YieldDataset(),
    'aquatic_invertebrates_EC10': @build_train_dataset_invertebrates_ec10/YieldDataset(),
    'algae_EC50': @build_train_dataset_algae_ec50/YieldDataset(),
    'algae_EC10': @build_train_dataset_algae_ec10/YieldDataset()
}
valid_datasets = {
    'fish_EC50': @build_valid_dataset_fish_ec50/YieldDataset(),
    'fish_EC10': @build_valid_dataset_fish_ec10/YieldDataset(),
    'aquatic_invertebrates_EC50': @build_valid_dataset_invertebrates_ec50/YieldDataset(),
    'aquatic_invertebrates_EC10': @build_valid_dataset_invertebrates_ec10/YieldDataset(),
    'algae_EC50': @build_valid_dataset_algae_ec50/YieldDataset(),
    'algae_EC10': @build_valid_dataset_algae_ec10/YieldDataset()
}
